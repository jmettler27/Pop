rules_version = '2';

// PRODUCTION rules. Deployed with `npm run deploy:rules` (via firebase.prod.json).
// The emulator uses the permissive firestore.rules instead.
//
// Reads stay open (the frontend reads Firestore directly via onSnapshot).
// All writes go through the firebase-admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
